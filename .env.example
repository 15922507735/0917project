# .env.example —— 环境变量模板
#
# 拷贝本文件为 .env 并填写真实值：
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)
#
# .env 已在 .gitignore 中忽略，不会被提交。
# 本项目使用 python-dotenv（见 requirements.txt），由 conftest.py 自动加载。

# ===================== Appium / 设备 =====================
# Appium 2 服务地址（Appium 2 已不带 /wd/hub）
APPIUM_SERVER=http://127.0.0.1:4723

# 设备名（Android 模拟器默认 emulator-5554，真机需用 adb devices 查看）
DEVICE_NAME=emulator-5554

# ===================== 待测 APP =====================
APP_PACKAGE=com.changan.oushangCos1
APP_ACTIVITY=.DefaultAliasActivity

# 全局显式等待超时（秒）
EXPECT_WAIT_TIMEOUT=10

# ===================== 测试账号 =====================
# 登录测试手机号
TEST_PHONE=18908390000
# 登录测试密码
TEST_PASSWORD=YourTestPassword

# ===================== MySQL（mcp_mysql.py 用） =====================
MYSQL_HOST=qiyuan-test.mysql.polardb.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=qiyuan_test
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=qiyuan
MYSQL_CHARSET=utf8mb4

# ===================== Jenkins CI =====================
# 是否跑发布相关用例（RUN_PUBLISH=1 时启用 publish 标记的用例）
RUN_PUBLISH=0